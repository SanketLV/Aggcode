DB_URL=

# Optional. Interface the WebSocket server binds to. Defaults to 127.0.0.1
# (loopback only). Setting this to 0.0.0.0 makes the agent reachable from
# other machines on the network; there is no authentication yet, so only do
# this on a trusted network.
AGGCODE_HOST=

# Optional. Port the WebSocket server listens on. Defaults to 3000. Set to 0
# to let the OS assign any free port (the real port is printed on startup).
AGGCODE_PORT=

# AI Provider: "claude" (default) or "opencode"
AI_PROVIDER=claude

# OpenCode settings (only needed when AI_PROVIDER=opencode)
OPENCODE_PORT=4096

# The agent layer reads no Anthropic key of its own. @anthropic-ai/claude-agent-sdk
# spawns the `claude` CLI and uses whatever credentials are already on the machine
# (an existing `claude` login, or an ambient ANTHROPIC_API_KEY). A clean machine or
# CI runner will have neither, and every agent run will fail.

# Optional. Key that encrypts API keys stored in MongoDB (32 bytes, base64,
# e.g. `openssl rand -base64 32`). Unset, a key is generated on first use at
# ~/.aggcode/credentials.key.
AGGCODE_CREDENTIALS_KEY=
