DB_URL=

# AI Provider: "claude" (default) or "opencode"
AI_PROVIDER=claude

# OpenCode settings (only needed when AI_PROVIDER=opencode)
OPENCODE_PORT=4096

# The agent layer reads no Anthropic key of its own. @anthropic-ai/claude-agent-sdk
# spawns the `claude` CLI and uses whatever credentials are already on the machine
# (an existing `claude` login, or an ambient ANTHROPIC_API_KEY). A clean machine or
# CI runner will have neither, and every agent run will fail.
